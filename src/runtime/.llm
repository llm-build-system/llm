type = "static-library"
name = "llm-runtime"
standards = ["C++23"]

[registries]
official = "https://github.com/llm-build-system/llm-registry"

[dependencies]
public = ["../core"]
private = ["official:json@3.12.0", "official:toml@3.4.0", "official:curl@8.23.0", "official:libarchive@3.8.9", "official:openssl@3.5.9", "official:zlib@1.3.2"]

[windows]
excludes = ["platform-posix.cpp"]
libraries = ["advapi32", "shell32", "ole32", "user32", "gdi32"]

[windows.defines]
private = ["UNICODE", "_UNICODE", "NOMINMAX", "WIN32_LEAN_AND_MEAN", "_WIN32_WINNT=0x0A00", "_CRT_SECURE_NO_WARNINGS"]

[linux]
excludes = ["platform-windows.cpp"]
libraries = ["pthread", "dl"]

[macos]
excludes = ["platform-windows.cpp"]
libraries = ["CoreFoundation.framework", "Security.framework"]
